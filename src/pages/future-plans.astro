---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlueprintUnit from '../components/BlueprintUnit.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/site';

const entries = await getCollection('futurePlans');
const doc = entries.find((e) => e.id === 'blueprint' || e.id.endsWith('blueprint')) ?? entries[0];

if (!doc) {
  throw new Error('找不到未來藍圖內容：請確認 src/content/future-plans/blueprint.md 存在');
}

const { drawing, revision, scale, title, subtitle, plans } = doc.data;

const statusLabel: Record<string, string> = {
  research: '研究',
  build: '建置',
  exhibit: '展演',
  explore: '探索',
};
---

<BaseLayout title={`${title} — Bingle`} description={subtitle ?? '未來工程藍圖'} hideFooter>
  <section class="blueprint-page relative" data-blueprint data-mode="solid">
    <!-- 工程圖紙外框 -->
    <div class="blueprint-sheet" data-blueprint-stage data-mode="solid">
      <!-- 圖紙抬頭 -->
      <header class="blueprint-head">
        <div class="blueprint-head-meta">
          <span>DWG · {drawing}</span>
          <span>SCALE · {scale}</span>
          <span>REV · {revision}</span>
          <span>
            MODE · <span data-mode-label>Solid</span>
          </span>
        </div>

        <div class="blueprint-head-main">
          <div class="min-w-0 flex-1">
            <p class="label-mono text-[10px] text-warm-taupe sm:text-xs">
              Engineering Blueprint
            </p>
            <h1 class="font-heading mt-1 text-xl font-bold tracking-tight text-neutral-900 sm:text-2xl md:text-3xl">
              {title}
            </h1>
            {
              subtitle && (
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-warm-taupe sm:text-base">
                  {subtitle}
                </p>
              )
            }
          </div>

          <button
            type="button"
            data-mode-toggle
            class="blueprint-toggle min-h-11 shrink-0 px-4 py-2 text-xs tracking-[0.14em] sm:text-sm"
            aria-pressed="false"
          >
            切換 Wireframe
          </button>
        </div>
      </header>

      <!-- 幾何單元網格 = 整張藍圖本體 -->
      <div class="blueprint-grid" role="list">
        {
          plans.map((plan, index) => (
            <article class="blueprint-unit" role="listitem" style={`--i: ${index}`}>
              <div class="blueprint-unit-rail">
                <span class="blueprint-id">{plan.id}</span>
                <span class="blueprint-year">{plan.year}</span>
              </div>

              <div class="blueprint-unit-canvas">
                <BlueprintUnit shape={plan.shape} code={plan.code} />
                <div class="blueprint-corners" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                  <i />
                </div>
              </div>

              <div class="blueprint-unit-copy">
                <div class="blueprint-unit-tags">
                  <span class="blueprint-status">{statusLabel[plan.status] ?? plan.status}</span>
                  {plan.code && <span class="blueprint-code">{plan.code}</span>}
                </div>
                <h2 class="blueprint-title">{plan.title}</h2>
                <p class="blueprint-desc">{plan.desc}</p>
              </div>
            </article>
          ))
        }
      </div>

      <!-- 圖紙標題欄（CAD title block） -->
      <footer class="blueprint-titleblock">
        <div class="blueprint-tb-cell">
          <span class="blueprint-tb-label">Drawn</span>
          <span class="blueprint-tb-value">Bingle</span>
        </div>
        <div class="blueprint-tb-cell">
          <span class="blueprint-tb-label">Sheet</span>
          <span class="blueprint-tb-value">1 / 1</span>
        </div>
        <div class="blueprint-tb-cell blueprint-tb-wide">
          <span class="blueprint-tb-label">Title</span>
          <span class="blueprint-tb-value">{drawing} · Future Structure</span>
        </div>
        <div class="blueprint-tb-cell">
          <span class="blueprint-tb-label">Units</span>
          <span class="blueprint-tb-value">{plans.length}</span>
        </div>
        <nav class="blueprint-tb-nav">
          <a href={withBase('contact')}>← Contact</a>
          <a href={withBase('secret-base')}>Secret Base →</a>
        </nav>
      </footer>
    </div>
  </section>
</BaseLayout>

<script>
  import { initBlueprintToggle } from '../scripts/blueprint-toggle';

  const root = document.querySelector<HTMLElement>('[data-blueprint]');
  const cleanup = root ? initBlueprintToggle(root) : () => {};
  document.addEventListener('astro:before-swap', () => cleanup(), { once: true });
</script>

<style>
  .blueprint-page {
    isolation: isolate;
    margin: -1.5rem -1rem 0;
    min-height: calc(100dvh - 4.5rem);
  }

  @media (min-width: 640px) {
    .blueprint-page {
      margin: -2rem -1.5rem 0;
    }
  }

  @media (min-width: 768px) {
    .blueprint-page {
      margin: -2.5rem -2rem 0;
    }
  }

  @media (min-width: 1024px) {
    .blueprint-page {
      margin: -3rem -2.5rem 0;
    }
  }

  .blueprint-page::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: #f1ead7;
    background-image:
      linear-gradient(color-mix(in srgb, #8a6bbe 12%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, #8a6bbe 12%, transparent) 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, #d4c4a8 32%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, #d4c4a8 32%, transparent) 1px, transparent 1px);
    background-size:
      80px 80px,
      80px 80px,
      16px 16px,
      16px 16px;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .blueprint-page[data-mode='wireframe']::before {
    opacity: 0.72;
  }

  .blueprint-sheet {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: inherit;
    margin: 0.75rem;
    padding: 1rem 0.9rem 0.9rem;
    border: 1.5px solid var(--bp-card-border, #d4c4a8);
    background: var(--bp-sheet-bg, color-mix(in srgb, #f1ead7 94%, #fff));
    box-shadow: inset 0 0 0 4px color-mix(in srgb, var(--bp-card-border, #d4c4a8) 55%, transparent);
    transition:
      background 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  @media (min-width: 640px) {
    .blueprint-sheet {
      margin: 1rem;
      padding: 1.25rem 1.25rem 1rem;
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .blueprint-sheet {
      margin: 1.25rem;
      padding: 1.5rem 1.5rem 1.1rem;
    }
  }

  .blueprint-sheet[data-mode='wireframe'] {
    --bp-fill: transparent;
    --bp-cut: transparent;
    --bp-stroke: #8a6bbe;
    --bp-card-bg: transparent;
    --bp-card-border: #8a6bbe;
    --bp-sheet-bg: color-mix(in srgb, #f1ead7 88%, #b6b9ff);
    --bp-text: #5c4a7a;
  }

  .blueprint-sheet[data-mode='solid'] {
    --bp-fill: color-mix(in srgb, #b6b9ff 28%, #f1ead7);
    --bp-cut: #f1ead7;
    --bp-stroke: #d4c4a8;
    --bp-card-bg: color-mix(in srgb, #f1ead7 90%, #fff);
    --bp-card-border: #d4c4a8;
    --bp-sheet-bg: color-mix(in srgb, #f1ead7 94%, #fff);
    --bp-text: #2a2a2a;
  }

  .blueprint-head {
    display: grid;
    gap: 0.85rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--bp-card-border);
    transition: border-color 0.25s ease;
  }

  .blueprint-head-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.1rem;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6e5f4b;
  }

  .blueprint-sheet[data-mode='wireframe'] .blueprint-head-meta {
    color: #8a6bbe;
  }

  .blueprint-head-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .blueprint-head-main {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .blueprint-toggle {
    border: 1px solid #8a6bbe;
    background: color-mix(in srgb, #f1ead7 85%, #fff);
    color: #8a6bbe;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .blueprint-toggle:hover,
  .blueprint-toggle:focus-visible {
    background: color-mix(in srgb, #b6b9ff 35%, #f1ead7);
    outline: none;
  }

  .blueprint-sheet[data-mode='wireframe'] .blueprint-toggle {
    background: transparent;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, #b6b9ff 50%, transparent);
  }

  .blueprint-grid {
    display: grid;
    gap: 0.9rem;
    flex: 1;
  }

  @media (min-width: 640px) {
    .blueprint-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .blueprint-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.15rem;
    }
  }

  .blueprint-unit {
    display: grid;
    gap: 0.55rem;
    padding: 0.75rem 0.8rem 0.9rem;
    border: 1px solid var(--bp-card-border);
    background: var(--bp-card-bg);
    color: var(--bp-text);
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .blueprint-sheet[data-mode='wireframe'] .blueprint-unit {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, #b6b9ff 30%, transparent);
  }

  .blueprint-unit-rail {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6e5f4b;
  }

  .blueprint-sheet[data-mode='wireframe'] .blueprint-unit-rail {
    color: #8a6bbe;
  }

  .blueprint-unit-canvas {
    position: relative;
    border: 1px dashed color-mix(in srgb, var(--bp-card-border) 80%, transparent);
    padding: 0.35rem 0.25rem 0.15rem;
    transition: border-color 0.25s ease;
  }

  .blueprint-unit-copy {
    display: grid;
    gap: 0.35rem;
  }

  .blueprint-unit-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.65rem;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6e5f4b;
  }

  .blueprint-status {
    color: #8a6bbe;
  }

  .blueprint-title {
    font-family: var(--font-heading);
    font-feature-settings: 'ss01' 1, 'cv01' 1;
    font-variant-alternates: stylistic(ss01);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
  }

  @media (min-width: 640px) {
    .blueprint-title {
      font-size: 1.05rem;
    }
  }

  .blueprint-desc {
    font-family: 'Plus Jakarta Sans', 'Noto Sans TC', sans-serif;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #6e5f4b;
  }

  .blueprint-sheet[data-mode='wireframe'] .blueprint-desc {
    color: color-mix(in srgb, #5c4a7a 88%, #8a6bbe);
  }

  .blueprint-corners i {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: #8a6bbe;
    border-style: solid;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .blueprint-sheet[data-mode='wireframe'] .blueprint-corners i {
    opacity: 1;
  }

  .blueprint-corners i:nth-child(1) {
    top: 3px;
    left: 3px;
    border-width: 1.5px 0 0 1.5px;
  }
  .blueprint-corners i:nth-child(2) {
    top: 3px;
    right: 3px;
    border-width: 1.5px 1.5px 0 0;
  }
  .blueprint-corners i:nth-child(3) {
    bottom: 3px;
    left: 3px;
    border-width: 0 0 1.5px 1.5px;
  }
  .blueprint-corners i:nth-child(4) {
    bottom: 3px;
    right: 3px;
    border-width: 0 1.5px 1.5px 0;
  }

  .blueprint-titleblock {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--bp-card-border);
    transition: border-color 0.25s ease;
  }

  @media (min-width: 768px) {
    .blueprint-titleblock {
      grid-template-columns: 1fr 1fr 2fr 1fr 1.4fr;
    }
  }

  .blueprint-tb-cell {
    display: grid;
    gap: 0.2rem;
    padding: 0.55rem 0.7rem;
    border-right: 1px solid var(--bp-card-border);
    border-bottom: 1px solid var(--bp-card-border);
    transition: border-color 0.25s ease;
  }

  @media (min-width: 768px) {
    .blueprint-tb-cell {
      border-bottom: none;
    }
  }

  .blueprint-tb-wide {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .blueprint-tb-wide {
      grid-column: auto;
    }
  }

  .blueprint-tb-label {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6e5f4b;
  }

  .blueprint-tb-value {
    font-family: 'Plus Jakarta Sans', 'Noto Sans TC', sans-serif;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--bp-text);
  }

  .blueprint-tb-nav {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.65rem 0.7rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }

  @media (min-width: 768px) {
    .blueprint-tb-nav {
      grid-column: auto;
      border-right: none;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
    }

    .blueprint-tb-cell:nth-child(4) {
      border-right: 1px solid var(--bp-card-border);
    }
  }

  .blueprint-tb-nav a {
    color: #6e5f4b;
    transition: color 0.2s ease;
  }

  .blueprint-tb-nav a:hover,
  .blueprint-tb-nav a:focus-visible {
    color: #8a6bbe;
    outline: none;
  }

  .blueprint-sheet[data-mode='wireframe'] .blueprint-tb-nav a {
    color: #8a6bbe;
  }
</style>
