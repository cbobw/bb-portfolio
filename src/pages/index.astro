---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/site';

/** 由 bb-profolio-gen.py 自動更新 */
const portfolioPdf = 'bb_profolio_0.1.4.pdf';

/**
 * 經歷小船：對應 biography.md 歷程與身分敘事
 * （身份／哲學／東海工設／吉吉童畫村）
 */
const journeyBoats = [
  {
    id: 'identity',
    kicker: '01 / Identity',
    title: '陳禹賓 / Bingle',
    body: '工業設計師 & 藝術創作者。在工業設計的幾何秩序中，融入手繪與純藝術的感性靈魂。',
    meta: 'binglebb@gmail.com',
    label: 'Bingle',
  },
  {
    id: 'philosophy',
    kicker: '02 / Philosophy',
    title: '理性骨架 · 感性皮膚',
    body: '「設計是物件的理性骨架，而藝術是物質的感性皮膚。」追求極簡，專注微觀細節與工藝觸感。',
    meta: 'Creative Philosophy',
    label: '哲學',
  },
  {
    id: 'thuid',
    kicker: '03 / Journey',
    title: '東海大學工業設計學系',
    body: '2025 – 至今｜產品外觀、結構驗證與數位建模（Creo / Blender），探索實體工藝與虛實界面。',
    meta: 'THUID · 在學',
    label: 'THUID',
  },
  {
    id: 'art',
    kicker: '04 / Journey',
    title: '吉吉童畫村',
    body: '2013 – 2022｜手繪、油畫及複合媒材啟蒙，培養色彩、材質肌理與視覺張力的敏銳度。',
    meta: 'Fine Art Roots',
    label: '童畫',
  },
];
---

<BaseLayout title="Bingle — 陳禹賓" description="工業設計與純藝術創作者 — 陳禹賓 Bingle">
  <!-- Hero：幾何微動 -->
  <section
    class="relative mb-16 grid min-h-[70dvh] items-center gap-8 sm:mb-20 sm:min-h-[75dvh] md:mb-24 md:grid-cols-[1.1fr_0.9fr] md:gap-10 lg:mb-28 lg:gap-14"
    data-hero
  >
    <div class="relative z-10 grid gap-4 sm:gap-5 md:gap-6">
      <p class="label-mono text-[10px] text-warm-taupe sm:text-xs">
        Industrial Design · Fine Art
      </p>
      <h1
        class="font-heading text-5xl font-bold text-neutral-900 sm:text-6xl md:text-7xl lg:text-8xl"
      >
        Bingle
      </h1>
      <p class="max-w-md text-sm leading-relaxed text-warm-taupe sm:text-base md:text-lg">
        在理性骨架中保留感性肌理。<br class="hidden sm:block" />
        陳禹賓 — 東海大學工業設計 × 純藝術背景。
      </p>
      <a
        href="#wave-journey"
        class="mt-2 inline-flex w-fit items-center gap-2 border-b border-purple-focus pb-0.5 text-xs tracking-[0.16em] text-purple-focus transition-colors hover:text-purple-hover sm:text-sm"
      >
        搖啊搖
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <div
      class="relative mx-auto aspect-square w-full max-w-[320px] overflow-hidden sm:max-w-[380px] md:max-w-none"
      data-geo-stage
      aria-hidden="true"
    >
      <div class="absolute inset-[12%] border border-beige-dark/50"></div>
      <div class="absolute inset-[22%] border border-dashed border-beige-dark/40"></div>
      <div
        data-geo
        class="absolute left-[18%] top-[20%] h-16 w-16 border border-purple-focus/70 bg-purple-hover/20 sm:h-20 sm:w-20"
      ></div>
      <div
        data-geo
        class="absolute right-[16%] top-[28%] h-14 w-14 rounded-full border border-beige-dark bg-beige-light sm:h-16 sm:w-16"
      ></div>
      <div
        data-geo
        class="absolute bottom-[22%] left-[28%] h-0 w-0 border-l-[28px] border-r-[28px] border-b-[48px] border-l-transparent border-r-transparent border-b-purple-focus/50 sm:border-l-[32px] sm:border-r-[32px] sm:border-b-[56px]"
      ></div>
      <div
        data-geo
        class="absolute bottom-[30%] right-[22%] h-12 w-12 rotate-45 border border-purple-hover/80 sm:h-14 sm:w-14"
      ></div>
      <div
        data-geo
        class="absolute left-1/2 top-[12%] h-px w-24 -translate-x-1/2 bg-beige-dark sm:w-32"
      ></div>
      <div
        data-geo
        class="absolute bottom-[14%] left-1/2 h-20 w-px -translate-x-1/2 bg-beige-dark/80 sm:h-24"
      ></div>
    </div>
  </section>

  <!-- 官方作品集 PDF（僅 portfolio + biography，不含 secret-base 等彩蛋） -->
  <section class="mb-14 border-b border-beige-dark/35 pb-12 sm:mb-16 sm:pb-14 md:mb-20 md:pb-16">
    <a
      id="portfolio-pdf-download"
      data-portfolio-pdf={portfolioPdf}
      href={withBase(`downloads/${portfolioPdf}`)}
      class="portfolio-pdf-download group inline-flex min-h-11 w-full max-w-md items-center justify-center gap-2 border border-beige-dark/70 bg-purple-focus px-6 py-3 font-mono text-xs tracking-[0.2em] text-beige-light shadow-[inset_0_0_0_1px_rgba(241,234,215,0.12)] transition-colors hover:border-purple-hover hover:bg-purple-hover hover:text-neutral-900 sm:min-h-12 sm:w-auto sm:px-8 sm:text-sm"
      download={portfolioPdf}
    >
      <span aria-hidden="true">↓</span>
      <span>下載官方作品集 (PDF)</span>
    </a>
      <p class="mt-3 max-w-md font-mono text-[10px] leading-relaxed tracking-[0.1em] text-warm-taupe sm:text-xs">
      正式版作品集 · 僅含作品與 biography，不含 secret-base 或實驗頁內容。
    </p>
  </section>

  <!-- 互動海浪小船：抓取檢視經歷 -->
  <section
    id="wave-journey"
    class="relative mb-8 sm:mb-10 md:mb-12"
    data-wave-boats
  >
    <header class="mb-6 grid gap-2 sm:mb-8 md:mb-10">
      <p class="label-mono text-[10px] text-warm-taupe sm:text-xs">
        Wave Journey
      </p>
      <h2 class="font-heading text-xl font-bold text-neutral-900 sm:text-2xl md:text-3xl">
        搖啊搖啊搖
      </h2>
      <p class="max-w-xl text-sm text-warm-taupe sm:text-base">
        抓起隨浪漂流的歲月小船，查看每一段經歷的故事。
      </p>
    </header>

    <div
      data-sea
      class="wave-sea relative mx-auto h-[min(58dvh,420px)] w-full overflow-hidden border border-beige-dark/45 sm:h-[min(56dvh,480px)] md:h-[min(52dvh,520px)] md:max-w-4xl"
      role="application"
      aria-label="經歷海浪：拖曳小船查看細節"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,transparent_0%,color-mix(in_srgb,#D4C4A8_18%,transparent)_42%,color-mix(in_srgb,#8A6BBE_12%,#F1EAD7)_100%)]"
        aria-hidden="true"
      ></div>

      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[62%]" aria-hidden="true">
        <div class="wave-layer wave-layer--back">
          <div class="wave-layer-track">
            <svg class="wave-strip" viewBox="0 0 1440 320" preserveAspectRatio="none">
              <path
                fill="color-mix(in srgb, #D4C4A8 38%, transparent)"
                d="M0,180 C180,240 360,110 540,180 C720,250 900,130 1080,190 C1260,250 1350,160 1440,180 L1440,320 L0,320 Z"
              ></path>
            </svg>
            <svg class="wave-strip" viewBox="0 0 1440 320" preserveAspectRatio="none">
              <path
                fill="color-mix(in srgb, #D4C4A8 38%, transparent)"
                d="M0,180 C180,240 360,110 540,180 C720,250 900,130 1080,190 C1260,250 1350,160 1440,180 L1440,320 L0,320 Z"
              ></path>
            </svg>
          </div>
        </div>
        <div class="wave-layer wave-layer--mid">
          <div class="wave-layer-track">
            <svg class="wave-strip" viewBox="0 0 1440 320" preserveAspectRatio="none">
              <path
                fill="color-mix(in srgb, #8A6BBE 18%, #F1EAD7)"
                d="M0,200 C160,140 320,260 540,200 C760,140 960,250 1180,190 C1320,150 1400,220 1440,200 L1440,320 L0,320 Z"
              ></path>
            </svg>
            <svg class="wave-strip" viewBox="0 0 1440 320" preserveAspectRatio="none">
              <path
                fill="color-mix(in srgb, #8A6BBE 18%, #F1EAD7)"
                d="M0,200 C160,140 320,260 540,200 C760,140 960,250 1180,190 C1320,150 1400,220 1440,200 L1440,320 L0,320 Z"
              ></path>
            </svg>
          </div>
        </div>
        <div class="wave-layer wave-layer--front">
          <div class="wave-layer-track">
            <svg class="wave-strip" viewBox="0 0 1440 320" preserveAspectRatio="none">
              <path
                fill="color-mix(in srgb, #D4C4A8 58%, #F1EAD7)"
                d="M0,230 C200,190 380,280 620,230 C860,180 1080,270 1260,220 C1360,195 1410,240 1440,230 L1440,320 L0,320 Z"
              ></path>
            </svg>
            <svg class="wave-strip" viewBox="0 0 1440 320" preserveAspectRatio="none">
              <path
                fill="color-mix(in srgb, #D4C4A8 58%, #F1EAD7)"
                d="M0,230 C200,190 380,280 620,230 C860,180 1080,270 1260,220 C1360,195 1410,240 1440,230 L1440,320 L0,320 Z"
              ></path>
            </svg>
          </div>
        </div>
      </div>

      {
        journeyBoats.map((boat) => (
          <button
            type="button"
            data-boat
            data-kicker={boat.kicker}
            data-title={boat.title}
            data-body={boat.body}
            data-meta={boat.meta}
            class="wave-boat absolute left-0 top-0 z-10 flex min-h-14 min-w-16 cursor-grab touch-none flex-col items-center gap-1.5 border-0 bg-transparent p-1.5 active:cursor-grabbing sm:min-h-16 sm:min-w-20"
            aria-label={`抓取小船：${boat.title}`}
            aria-pressed="false"
            style="will-change: transform"
          >
            <svg
              class="wave-boat-svg h-14 w-20 sm:h-16 sm:w-24 md:h-[4.5rem] md:w-28"
              viewBox="0 0 64 44"
              fill="none"
              aria-hidden="true"
            >
              <line x1="30" y1="4" x2="30" y2="28" stroke="#8A6BBE" stroke-width="1.5" />
              <path d="M31 6 L48 26 L31 26 Z" fill="#B6B9FF" fill-opacity="0.55" stroke="#8A6BBE" stroke-width="1.2" />
              <path d="M8 30 L56 30 L50 38 L14 38 Z" fill="#F1EAD7" stroke="#8A6BBE" stroke-width="1.4" />
              <line x1="14" y1="34" x2="50" y2="34" stroke="#D4C4A8" stroke-width="1" />
            </svg>
            <span class="label-mono max-w-[5.5rem] overflow-visible text-[10px] leading-normal text-warm-taupe sm:max-w-[6.5rem] sm:text-xs">
              {boat.label}
            </span>
          </button>
        ))
      }

      <aside
        data-boat-detail
        class="pointer-events-none absolute inset-x-3 bottom-3 z-40 max-w-md border border-beige-dark/60 bg-beige-light/95 p-4 backdrop-blur-sm sm:inset-x-auto sm:bottom-4 sm:left-4 sm:right-auto sm:p-5 md:left-6"
        hidden
        aria-hidden="true"
        aria-live="polite"
      >
        <p data-boat-detail-kicker class="label-mono mb-1.5 text-[10px] text-warm-taupe sm:text-xs"></p>
        <h3 data-boat-detail-title class="font-heading mb-2 text-base font-bold text-neutral-900 sm:text-lg"></h3>
        <p data-boat-detail-body class="text-sm leading-relaxed text-warm-taupe"></p>
        <p data-boat-detail-meta class="label-mono mt-3 text-[10px] text-purple-focus sm:text-xs"></p>
      </aside>

      <p
        class="label-mono pointer-events-none absolute left-3 top-3 text-[9px] text-warm-taupe/80 sm:left-4 sm:top-4 sm:text-[10px]"
        aria-hidden="true"
      >
        Drag · Grab · Release
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initHeroGeometry } from '../scripts/hero-geometry';
  import { initWaveBoats } from '../scripts/wave-boats';

  const geo = document.querySelector<HTMLElement>('[data-geo-stage]');
  const wave = document.querySelector<HTMLElement>('[data-wave-boats]');

  const cleanups: Array<() => void> = [];
  if (geo) cleanups.push(initHeroGeometry(geo));
  if (wave) cleanups.push(initWaveBoats(wave));

  document.addEventListener(
    'astro:before-swap',
    () => cleanups.forEach((fn) => fn()),
    { once: true },
  );
</script>

<style>
  .wave-layer {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .wave-layer-track {
    display: flex;
    width: 200%;
    height: 100%;
    will-change: transform;
  }

  .wave-strip {
    display: block;
    height: 100%;
    width: 50%;
    flex-shrink: 0;
  }

  .wave-layer--back {
    animation: wave-bob 6s ease-in-out infinite;
  }

  .wave-layer--back .wave-layer-track {
    animation: wave-scroll 16s linear infinite;
  }

  .wave-layer--mid {
    animation: wave-bob 4.5s ease-in-out infinite reverse;
  }

  .wave-layer--mid .wave-layer-track {
    animation: wave-scroll 11s linear infinite reverse;
  }

  .wave-layer--front {
    animation: wave-bob 3.4s ease-in-out infinite;
  }

  .wave-layer--front .wave-layer-track {
    animation: wave-scroll 7.5s linear infinite;
  }

  .wave-boat.is-grabbed {
    z-index: 30;
    filter: drop-shadow(0 8px 14px color-mix(in srgb, #8a6bbe 30%, transparent));
  }

  .wave-boat:focus-visible {
    outline: 2px solid #8a6bbe;
    outline-offset: 4px;
  }

  @keyframes wave-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes wave-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-layer--back,
    .wave-layer--mid,
    .wave-layer--front,
    .wave-layer--back .wave-layer-track,
    .wave-layer--mid .wave-layer-track,
    .wave-layer--front .wave-layer-track {
      animation: none;
    }
  }
</style>
