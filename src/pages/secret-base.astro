---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/site';

const profiles = await getCollection('profile');
const funFacts = profiles.find((e) => e.id === 'fun-facts' || e.id.endsWith('fun-facts'));

const facts = (funFacts?.data.facts ?? []).map((text) => ({ text }));
const memes = (funFacts?.data.memes ?? []).map((m) => ({
  label: m.label,
  shape: (m.shape ?? 'rect') as 'circle' | 'rect' | 'tri',
}));
---

<BaseLayout
  title="Secret Base — Bingle"
  description="反差基地：開啟彩蛋，讓排版遵守重力"
  fullBleed
  hideFooter
>
  <section
    class="egg-root relative flex h-[calc(100dvh-3rem)] flex-col md:h-[calc(100dvh-3.5rem)] lg:h-[calc(100dvh-4rem)]"
    data-secret-base
    data-facts={JSON.stringify(facts)}
    data-memes={JSON.stringify(memes)}
  >
    <div class="relative z-20 flex items-start justify-between gap-3 p-3 sm:p-4 md:p-5">
      <div class="grid gap-1 border border-beige-dark/40 bg-beige-light/95 px-3 py-2 backdrop-blur-sm sm:px-4">
        <p class="label-mono text-[10px] text-warm-taupe sm:text-xs">
          Secret Base
        </p>
        <h1 class="font-heading text-sm font-bold text-neutral-900 sm:text-base md:text-lg">反差基地</h1>
      </div>

      <button
        type="button"
        data-egg-switch
        class="min-h-11 border border-purple-focus bg-beige-light px-4 py-2 text-xs tracking-[0.14em] text-purple-focus transition-colors hover:bg-purple-hover/25 sm:text-sm"
        aria-pressed="false"
      >
        開啟彩蛋
      </button>
    </div>

    <div
      data-egg-minimal
      class="relative z-10 flex flex-1 flex-col items-center justify-center gap-4 px-6 pb-[5rem] text-center md:pb-8"
    >
      <p class="label-mono text-[10px] text-warm-taupe sm:text-xs">Minimal Mode</p>
      <p class="max-w-xs text-sm leading-relaxed text-neutral-600 sm:max-w-sm sm:text-base">
        這裡很安靜。<br />
        按下右上角開關，重力會接手排版。
      </p>
      <p class="text-[10px] tracking-[0.16em] text-warm-taupe/80 sm:text-xs">
        資料來源 · fun-facts.md
      </p>
      <a
        href={withBase('future-plans')}
        class="text-xs tracking-[0.12em] text-purple-focus hover:text-purple-hover"
      >
        Future Plans →
      </a>
    </div>

    <div
      data-egg-arena
      class="egg-arena absolute inset-0 z-10 touch-none overflow-hidden pb-[4.25rem] md:pb-0"
      hidden
    >
      <div data-egg-layer class="egg-layer absolute inset-0"></div>
      <p
        class="pointer-events-none absolute bottom-[calc(4.75rem+env(safe-area-inset-bottom))] left-1/2 z-20 -translate-x-1/2 whitespace-nowrap text-[10px] tracking-[0.14em] text-warm-taupe md:bottom-4"
      >
        拖拽物件 · 邊界已鎖定
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initSecretPhysics } from '../scripts/secret-physics';

  const root = document.querySelector<HTMLElement>('[data-secret-base]');
  if (root) {
    const facts = JSON.parse(root.dataset.facts || '[]') as { text: string }[];
    const memes = JSON.parse(root.dataset.memes || '[]') as {
      label: string;
      shape: 'circle' | 'rect' | 'tri';
    }[];

    const cleanup = initSecretPhysics(root, { facts, memes });
    document.addEventListener('astro:before-swap', () => cleanup(), { once: true });
  }
</script>

<style is:global>
  .egg-root {
    background: #f1ead7;
  }

  .egg-root.is-chaos {
    background:
      radial-gradient(circle at 20% 10%, color-mix(in srgb, #b6b9ff 22%, transparent), transparent 45%),
      #f1ead7;
  }

  .egg-arena {
    cursor: grab;
  }

  .egg-arena.is-dragging {
    cursor: grabbing;
  }

  .egg-layer .egg-card,
  .egg-layer .egg-meme {
    position: absolute;
    left: 0;
    top: 0;
    will-change: transform;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }

  .egg-layer .egg-card {
    border: 1px solid #d4c4a8;
    background: color-mix(in srgb, #f1ead7 94%, #fff);
    padding: 0.65rem 0.75rem;
    font-family: 'Plus Jakarta Sans', 'Noto Sans TC', sans-serif;
    font-size: 11px;
    line-height: 1.45;
    color: #6e5f4b;
    box-shadow: 0 4px 14px color-mix(in srgb, #8a6bbe 12%, transparent);
  }

  @media (min-width: 640px) {
    .egg-layer .egg-card {
      font-size: 12px;
      padding: 0.75rem 0.85rem;
    }
  }

  .egg-layer .egg-meme {
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-feature-settings: 'ss01' 1, 'cv01' 1;
    font-variant-alternates: stylistic(ss01);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #5c4a7a;
    border: 1.5px solid #8a6bbe;
    background: color-mix(in srgb, #b6b9ff 35%, #f1ead7);
  }

  .egg-layer .egg-meme--circle {
    border-radius: 9999px;
  }

  .egg-layer .egg-meme--rect {
    border-radius: 2px;
  }

  .egg-layer .egg-meme--tri {
    clip-path: polygon(50% 8%, 92% 88%, 8% 88%);
    border: none;
    background: #8a6bbe;
    color: #f1ead7;
  }
</style>
