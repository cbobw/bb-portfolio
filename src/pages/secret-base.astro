---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/site';
import secretData from '../content/secret/data.json';

type RoomItemMode = 'day' | 'night' | 'all';

type RoomItem = {
  id: string;
  name: string;
  mode: RoomItemMode;
  position: { x: number; y: number };
  image?: string;
  renderType: string;
  title: string;
  subtitle: string;
  tags: string[];
  detail: string;
  accentColor: string;
};

const profile = secretData.profile;
const roomItems = secretData.roomItems as RoomItem[];

const toAsset = (path: string) => {
  const cleaned = path.replace(/^\//, '');
  return cleaned ? withBase(cleaned) : '';
};
---

<BaseLayout
  title="Secret Base — Bingle"
  description="CCTV 反差基地：監視器視角探索房間角落的秘密物件"
  fullBleed
  hideFooter
>
  <section
    class="cctv-root relative flex h-[calc(100dvh-3rem)] flex-col overflow-hidden md:h-[calc(100dvh-3.5rem)] lg:h-[calc(100dvh-4rem)]"
    data-secret-room
    data-mode="day"
  >
    <!-- CCTV HUD -->
    <div class="cctv-hud pointer-events-none absolute inset-x-0 top-0 z-40 flex items-start justify-between gap-3 p-3 sm:p-4 md:p-5">
      <div class="cctv-chip pointer-events-auto max-w-[min(100%,16rem)] border border-beige-dark/45 bg-beige-light/85 px-3 py-2 backdrop-blur-sm sm:max-w-xs">
        <p class="label-mono text-[10px] text-warm-taupe sm:text-xs">CAM_01 · SECRET_BASE</p>
        <h1 class="font-heading text-sm font-bold text-neutral-900 sm:text-base">{profile.nickname}</h1>
        <p class="mt-0.5 text-[10px] leading-snug text-warm-taupe sm:text-xs">{profile.instagram}</p>
      </div>

      <div class="flex flex-col items-end gap-2">
        <div class="cctv-rec border border-beige-dark/45 bg-[#1c1528]/82 px-3 py-2 font-mono text-[10px] text-beige-light backdrop-blur-sm sm:text-xs">
          <div class="flex items-center gap-2">
            <span class="cctv-rec-dot" aria-hidden="true"></span>
            <span class="tracking-[0.18em]">REC</span>
          </div>
          <p class="mt-1 tracking-wide text-beige-dark" data-cctv-time>— —</p>
          <p class="mt-0.5 text-[9px] tracking-[0.14em] text-purple-hover/90 sm:text-[10px]">CAM_01 SECRET_BASE</p>
        </div>

        <button
          type="button"
          class="cctv-mode-btn pointer-events-auto label-mono min-h-11 border border-beige-dark/50 bg-beige-light/90 px-3 py-2 text-[10px] text-warm-taupe backdrop-blur-sm transition-colors hover:border-purple-focus hover:text-purple-focus sm:text-xs"
          data-mode-toggle
          aria-pressed="false"
          aria-label="切換晝夜模式"
        >
          MODE · <span data-mode-label>DAY</span>
        </button>
      </div>
    </div>

    <!-- 可滑動監視器畫面 -->
    <div
      class="cctv-viewport relative z-10 min-h-0 flex-1 overflow-auto overscroll-contain pb-[4.5rem] touch-pan-x touch-pan-y md:overflow-hidden md:pb-0"
      data-room-viewport
    >
      <div
        class="cctv-stage relative mx-auto h-[max(100%,30rem)] w-[max(100%,44rem)] min-h-full min-w-full md:h-full md:w-full"
        data-room-scene
      >
        <!-- 角落空間：左牆 / 右牆 / 地板 -->
        <div class="cctv-room absolute inset-0" aria-hidden="true">
          <div class="cctv-wall cctv-wall--left"></div>
          <div class="cctv-wall cctv-wall--right"></div>
          <div class="cctv-floor"></div>
          <div class="cctv-corner-line"></div>
          <div class="cctv-scanlines"></div>
        </div>

        <!-- 夜模式檯燈光束 -->
        <div class="cctv-lamp pointer-events-none absolute inset-0 z-[5] opacity-0" data-room-lamp aria-hidden="true">
          <div class="cctv-lamp-beam"></div>
          <div class="cctv-lamp-fixture"></div>
        </div>

        <!-- 牆面時鐘（左牆） -->
        <button
          type="button"
          class="cctv-clock absolute z-20 touch-manipulation"
          style="left:22%;top:28%"
          data-room-clock
          aria-pressed="false"
          aria-label="牆面時鐘：白天，點擊切換至黑夜"
        >
          <svg viewBox="0 0 100 100" class="h-full w-full" aria-hidden="true">
            <circle cx="50" cy="50" r="46" class="cctv-clock-ring" fill="none" stroke-width="2.5"></circle>
            <circle cx="50" cy="50" r="38" class="cctv-clock-face"></circle>
            {
              [0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330].map((deg) => (
                <line
                  x1="50"
                  y1="14"
                  x2="50"
                  y2={deg % 90 === 0 ? 22 : 18}
                  stroke-width={deg % 90 === 0 ? 2.2 : 1.2}
                  transform={`rotate(${deg} 50 50)`}
                  class="cctv-clock-tick"
                />
              ))
            }
            <g data-clock-minute>
              <line x1="50" y1="50" x2="50" y2="24" stroke-width="1.6" stroke-linecap="round" class="cctv-clock-hand"></line>
            </g>
            <g data-clock-hour>
              <line x1="50" y1="50" x2="50" y2="32" stroke-width="2.6" stroke-linecap="round" class="cctv-clock-hand"></line>
            </g>
            <circle cx="50" cy="50" r="2.6" class="cctv-clock-hub"></circle>
          </svg>
        </button>

        <!-- 真實物件 -->
        {
          roomItems.map((item) => {
            const src = item.image?.trim() ? toAsset(item.image) : '';
            const hasImage = Boolean(src);
            return (
              <button
                type="button"
                class="cctv-item absolute z-20 -translate-x-1/2 -translate-y-1/2 touch-manipulation focus-visible:outline-none"
                style={`left:${item.position.x}%;top:${item.position.y}%;--item-accent:${item.accentColor};--item-z:${Math.round(item.position.y)}`}
                data-room-item
                data-id={item.id}
                data-mode={item.mode}
                data-name={item.name}
                data-title={item.title}
                data-subtitle={item.subtitle}
                data-detail={item.detail}
                data-tags={item.tags.join('|')}
                data-accent={item.accentColor}
                aria-label={`${item.name}：${item.title}`}
                hidden={item.mode === 'night'}
                aria-hidden={item.mode === 'night' ? 'true' : 'false'}
                tabindex={item.mode === 'night' ? -1 : 0}
              >
                <span class="cctv-item-glow" aria-hidden="true"></span>
                <span class="cctv-item-visual" aria-hidden="true">
                  {hasImage && (
                    <img
                      src={src}
                      alt=""
                      class="cctv-item-img"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <span
                    class={`obj obj--${item.renderType}`}
                    data-obj-fallback
                    hidden={hasImage}
                  >
                    {item.renderType === 'vinyl' && (
                      <svg viewBox="0 0 120 120" class="obj-svg">
                        <defs>
                          <radialGradient id={`vg-${item.id}`} cx="38%" cy="32%" r="65%">
                            <stop offset="0%" stop-color="#4a4a4a" />
                            <stop offset="45%" stop-color="#141414" />
                            <stop offset="100%" stop-color="#0a0a0a" />
                          </radialGradient>
                        </defs>
                        <ellipse cx="60" cy="112" rx="34" ry="6" fill="#6e5f4b" opacity="0.28" />
                        <circle cx="60" cy="56" r="48" fill={`url(#vg-${item.id})`} />
                        {[18, 24, 30, 36, 42].map((r) => (
                          <circle cx="60" cy="56" r={r} fill="none" stroke="#2a2a2a" stroke-width="0.8" opacity="0.7" />
                        ))}
                        <circle cx="60" cy="56" r="14" fill="#8a6bbe" />
                        <circle cx="60" cy="56" r="4" fill="#1c1528" />
                        <ellipse cx="42" cy="38" rx="14" ry="7" fill="#fff" opacity="0.12" />
                      </svg>
                    )}

                    {item.renderType === 'headphones' && (
                      <svg viewBox="0 0 120 100" class="obj-svg">
                        <ellipse cx="60" cy="92" rx="28" ry="5" fill="#6e5f4b" opacity="0.25" />
                        <path d="M28 48c0-22 14-36 32-36s32 14 32 36" fill="none" stroke="#3d3429" stroke-width="7" stroke-linecap="round" />
                        <path d="M28 48c0-22 14-36 32-36s32 14 32 36" fill="none" stroke="#8a6bbe" stroke-width="2.5" stroke-linecap="round" opacity="0.7" />
                        <rect x="18" y="42" width="18" height="28" rx="6" fill="#2a2435" stroke="#b6b9ff" stroke-width="1.5" />
                        <rect x="84" y="42" width="18" height="28" rx="6" fill="#2a2435" stroke="#b6b9ff" stroke-width="1.5" />
                        <rect x="21" y="48" width="12" height="14" rx="3" fill="#b6b9ff" opacity="0.35" />
                        <rect x="87" y="48" width="12" height="14" rx="3" fill="#b6b9ff" opacity="0.35" />
                      </svg>
                    )}

                    {item.renderType === 'acrylic-stand' && (
                      <svg viewBox="0 0 90 130" class="obj-svg">
                        <ellipse cx="45" cy="122" rx="26" ry="5" fill="#6e5f4b" opacity="0.25" />
                        <path d="M18 118h54l-6-10H24z" fill="#d4c4a8" stroke="#6e5f4b" stroke-width="1" />
                        <rect x="28" y="16" width="34" height="92" rx="3" fill="#e6e0f4" stroke="#8a6bbe" stroke-width="1.6" opacity="0.92" />
                        <circle cx="45" cy="42" r="10" fill="#8a6bbe" opacity="0.55" />
                        <path d="M33 68c4-10 20-10 24 0v28H33V68z" fill="#8a6bbe" opacity="0.45" />
                        <line x1="30" y1="108" x2="60" y2="16" stroke="#fff" stroke-width="1.2" opacity="0.35" />
                      </svg>
                    )}

                    {item.renderType === 'cards' && (
                      <svg viewBox="0 0 110 90" class="obj-svg">
                        <ellipse cx="55" cy="82" rx="36" ry="6" fill="#6e5f4b" opacity="0.22" />
                        <g transform="rotate(-12 40 50)">
                          <rect x="22" y="22" width="40" height="56" rx="3" fill="#f1ead7" stroke="#6e5f4b" stroke-width="1.4" />
                          <circle cx="42" cy="50" r="8" fill="#8a6bbe" opacity="0.5" />
                        </g>
                        <g transform="rotate(6 58 48)">
                          <rect x="40" y="18" width="40" height="56" rx="3" fill="#2a1f3d" stroke="#8a6bbe" stroke-width="1.4" />
                          <path d="M52 36h16v8H52zM48 50h24v4H48zM52 60h16v8H52z" fill="#b6b9ff" opacity="0.55" />
                        </g>
                        <g transform="rotate(18 72 52)">
                          <rect x="54" y="24" width="40" height="56" rx="3" fill="#f1ead7" stroke="#8a6bbe" stroke-width="1.4" />
                          <text x="74" y="56" text-anchor="middle" font-size="14" fill="#8a6bbe" font-family="monospace">★</text>
                        </g>
                      </svg>
                    )}

                    {item.renderType === 'sandpaper' && (
                      <svg viewBox="0 0 120 90" class="obj-svg">
                        <ellipse cx="60" cy="82" rx="40" ry="6" fill="#6e5f4b" opacity="0.22" />
                        <rect x="14" y="28" width="58" height="42" rx="2" fill="#c4a574" stroke="#6e5f4b" stroke-width="1.2" />
                        <circle cx="28" cy="40" r="1.2" fill="#6e5f4b" opacity="0.45" />
                        <circle cx="44" cy="48" r="1" fill="#6e5f4b" opacity="0.4" />
                        <circle cx="55" cy="36" r="1.1" fill="#6e5f4b" opacity="0.35" />
                        <circle cx="36" cy="55" r="0.9" fill="#6e5f4b" opacity="0.4" />
                        <rect x="62" y="34" width="36" height="28" rx="1.5" fill="#d4b896" stroke="#6e5f4b" stroke-width="1.2" />
                        <path d="M66 40h28M66 48h28M66 56h20" stroke="#6e5f4b" stroke-width="1" opacity="0.35" />
                      </svg>
                    )}

                    {item.renderType === 'can-cheese' && (
                      <svg viewBox="0 0 120 110" class="obj-svg">
                        <ellipse cx="60" cy="100" rx="38" ry="6" fill="#6e5f4b" opacity="0.22" />
                        <rect x="28" y="28" width="28" height="58" rx="4" fill="#c0392b" stroke="#6e5f4b" stroke-width="1.2" />
                        <rect x="28" y="28" width="28" height="10" rx="4" fill="#8e1b12" />
                        <rect x="28" y="48" width="28" height="14" fill="#f1ead7" opacity="0.9" />
                        <text x="42" y="59" text-anchor="middle" font-size="7" fill="#8a6bbe" font-family="monospace" font-weight="700">沙士</text>
                        <ellipse cx="42" cy="28" rx="14" ry="4" fill="#e8c4c0" />
                        <path d="M70 70l28-10 8 22-30 12z" fill="#e8b84a" stroke="#6e5f4b" stroke-width="1.1" />
                        <circle cx="84" cy="72" r="3" fill="#f1ead7" opacity="0.5" />
                        <circle cx="92" cy="80" r="2.2" fill="#f1ead7" opacity="0.4" />
                      </svg>
                    )}

                    {item.renderType === 'stone' && (
                      <svg viewBox="0 0 140 100" class="obj-svg obj-svg--stone">
                        <ellipse cx="70" cy="88" rx="48" ry="8" fill="#6e5f4b" opacity="0.28" />
                        <path
                          d="M28 70c-6-18 4-42 28-48 16-4 34 2 46 16 10 12 14 30 6 42-6 10-22 16-42 16-22 0-34-8-38-26z"
                          fill="#8a8178"
                          stroke="#6e5f4b"
                          stroke-width="1.4"
                        />
                        <path
                          d="M40 58c4-14 18-22 34-18 8 2 14 10 12 18"
                          fill="none"
                          stroke="#b8afa4"
                          stroke-width="2"
                          opacity="0.55"
                        />
                        <ellipse cx="52" cy="48" rx="10" ry="5" fill="#fff" opacity="0.12" />
                      </svg>
                    )}

                    {!['vinyl', 'headphones', 'acrylic-stand', 'cards', 'sandpaper', 'can-cheese', 'stone'].includes(
                      item.renderType,
                    ) && (
                      <svg viewBox="0 0 80 80" class="obj-svg">
                        <ellipse cx="40" cy="70" rx="22" ry="5" fill="#6e5f4b" opacity="0.25" />
                        <circle cx="40" cy="38" r="22" fill="#8a6bbe" opacity="0.75" stroke="#d4c4a8" stroke-width="1.5" />
                      </svg>
                    )}
                  </span>
                </span>
                <span class="sr-only">{item.name}</span>
              </button>
            );
          })
        }

        <p class="cctv-hint pointer-events-none absolute bottom-3 left-1/2 z-20 -translate-x-1/2 text-center font-mono text-[9px] tracking-[0.14em] sm:text-[10px] md:bottom-4">
          點擊時鐘／MODE 切換晝夜 · 點擊物件檢視
        </p>
      </div>
    </div>

    <!-- Modal -->
    <div
      class="cctv-modal fixed inset-0 z-50 flex items-end justify-center bg-[#1C1528]/55 p-3 backdrop-blur-[2px] sm:items-center sm:p-6"
      data-room-modal
      hidden
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-labelledby="cctv-modal-title"
    >
      <div
        class="relative max-h-[min(88dvh,36rem)] w-full max-w-lg overflow-y-auto border border-beige-dark bg-beige-light shadow-[0_16px_48px_color-mix(in_srgb,#8A6BBE_22%,transparent)]"
        data-modal-panel
        style="--modal-accent:#8A6BBE"
      >
        <div class="flex items-start justify-between gap-3 border-b border-beige-dark/60 px-4 py-3 sm:px-5 sm:py-4">
          <div class="min-w-0">
            <p class="label-mono text-[10px] text-warm-taupe sm:text-xs" data-modal-name></p>
            <h2 id="cctv-modal-title" class="font-heading mt-1 text-lg font-bold text-neutral-900 sm:text-xl" data-modal-title></h2>
          </div>
          <button
            type="button"
            class="flex h-11 w-11 shrink-0 items-center justify-center border border-beige-dark text-warm-taupe transition-colors hover:border-purple-focus hover:text-purple-focus"
            data-modal-close
            aria-label="關閉"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
        </div>

        <div class="space-y-4 px-4 py-4 sm:px-5 sm:py-5">
          <p class="text-sm text-warm-taupe sm:text-base" data-modal-subtitle></p>
          <div class="flex flex-wrap gap-2" data-modal-tags></div>
          <p class="border-l-2 pl-3 text-sm leading-relaxed text-neutral-800 sm:text-base" style="border-color: var(--modal-accent)" data-modal-detail></p>

          <aside class="grid gap-2 border border-beige-dark/50 bg-beige-dark/15 p-3 sm:p-4">
            <p class="label-mono text-[10px] text-purple-focus sm:text-xs">Profile</p>
            <p class="font-heading text-sm font-semibold text-neutral-900 sm:text-base">「{profile.quote}」</p>
            <p class="text-xs leading-relaxed text-warm-taupe sm:text-sm">{profile.social}</p>
            <p class="text-xs leading-relaxed text-warm-taupe sm:text-sm">{profile.comedyStyle}</p>
            <p class="text-[10px] text-warm-taupe/80 sm:text-xs">{profile.warning}</p>
          </aside>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initSecretRoom } from '../scripts/secret-room';

  const root = document.querySelector<HTMLElement>('[data-secret-room]');
  if (root) {
    const cleanup = initSecretRoom(root, { initialMode: 'day' });
    document.addEventListener('astro:before-swap', () => cleanup(), { once: true });
  }
</script>

<style is:global>
  .cctv-root {
    --wall-l: #ebe2cd;
    --wall-r: #e4d9bf;
    --floor: #d4c4a8;
    --line: color-mix(in srgb, #6e5f4b 35%, #d4c4a8);
    --ink: #6e5f4b;
    --ambient: #f1ead7;
    background: var(--ambient);
    transition: background-color 0.5s ease;
  }

  .cctv-root.is-night {
    --wall-l: #241832;
    --wall-r: #1a1228;
    --floor: #120e1c;
    --line: color-mix(in srgb, #8a6bbe 55%, #d4c4a8);
    --ink: #d4c4a8;
    --ambient: #14101c;
    background:
      radial-gradient(ellipse 50% 45% at 55% 58%, color-mix(in srgb, #8a6bbe 26%, transparent), transparent 70%),
      var(--ambient);
  }

  /* —— CCTV 角落房間 —— */
  .cctv-room {
    background: var(--ambient);
    transition: background-color 0.5s ease;
  }

  .cctv-wall--left {
    position: absolute;
    left: 0;
    top: 0;
    width: 54%;
    height: 72%;
    background:
      linear-gradient(115deg, color-mix(in srgb, var(--wall-l) 92%, #fff) 0%, var(--wall-l) 55%, color-mix(in srgb, var(--wall-l) 85%, #6e5f4b) 100%);
    clip-path: polygon(0 0, 100% 8%, 100% 100%, 0 78%);
    border-right: 1px solid var(--line);
    transition: background 0.5s ease, border-color 0.5s ease;
  }

  .cctv-wall--right {
    position: absolute;
    right: 0;
    top: 0;
    width: 54%;
    height: 72%;
    background:
      linear-gradient(245deg, color-mix(in srgb, var(--wall-r) 90%, #fff) 0%, var(--wall-r) 50%, color-mix(in srgb, var(--wall-r) 80%, #6e5f4b) 100%);
    clip-path: polygon(0 8%, 100% 0, 100% 78%, 0 100%);
    border-left: 1px solid var(--line);
    transition: background 0.5s ease, border-color 0.5s ease;
  }

  .cctv-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48%;
    background:
      repeating-linear-gradient(
        105deg,
        color-mix(in srgb, var(--floor) 88%, #6e5f4b) 0 1px,
        transparent 1px 56px
      ),
      linear-gradient(180deg, color-mix(in srgb, var(--floor) 75%, #6e5f4b), var(--floor));
    clip-path: polygon(0 42%, 50% 0, 100% 42%, 100% 100%, 0 100%);
    transition: background 0.5s ease;
  }

  .cctv-corner-line {
    position: absolute;
    left: 50%;
    top: 8%;
    width: 1px;
    height: 56%;
    background: linear-gradient(180deg, transparent, var(--line) 20%, var(--line) 80%, transparent);
    transform: translateX(-50%);
    opacity: 0.7;
    transition: background 0.5s ease;
  }

  .cctv-scanlines {
    pointer-events: none;
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background: repeating-linear-gradient(
      0deg,
      #000 0 1px,
      transparent 1px 3px
    );
    mix-blend-mode: multiply;
  }

  .cctv-root.is-night .cctv-scanlines {
    opacity: 0.08;
    mix-blend-mode: screen;
    background: repeating-linear-gradient(
      0deg,
      #b6b9ff 0 1px,
      transparent 1px 4px
    );
  }

  /* HUD */
  .cctv-root.is-night .cctv-chip {
    border-color: color-mix(in srgb, #8a6bbe 45%, transparent);
    background: color-mix(in srgb, #1c1528 88%, transparent);
  }

  .cctv-root.is-night .cctv-chip h1 {
    color: #f1ead7;
  }

  .cctv-root.is-night .cctv-chip p {
    color: #d4c4a8;
  }

  .cctv-root.is-night .cctv-mode-btn {
    border-color: color-mix(in srgb, #8a6bbe 50%, transparent);
    background: color-mix(in srgb, #1c1528 88%, transparent);
    color: #b6b9ff;
  }

  .cctv-rec-dot {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 9999px;
    background: #e11d48;
    box-shadow: 0 0 8px #e11d48;
    animation: cctv-blink 1.2s ease-in-out infinite;
  }

  @keyframes cctv-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  /* 檯燈 */
  .cctv-lamp-beam {
    position: absolute;
    left: 48%;
    top: 36%;
    width: min(70vw, 28rem);
    height: min(55vh, 22rem);
    transform: translate(-30%, 0) rotate(18deg);
