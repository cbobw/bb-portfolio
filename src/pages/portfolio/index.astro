---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/site';

const projects = (await getCollection('portfolio')).sort((a, b) => {
  const yearCmp = b.data.year.localeCompare(a.data.year);
  if (yearCmp !== 0) return yearCmp;
  return a.data.title.localeCompare(b.data.title, 'zh-Hant');
});

const categories = ['all', ...[...new Set(projects.map((p) => p.data.category))].sort()];
const total = projects.length;
---

<BaseLayout
  title="Work — Bingle"
  description="作品圖板目錄 — 陳禹賓 Bingle 工業設計與純藝術作品"
>
  <div data-plate-catalog class="plate-catalog -mx-4 sm:-mx-6 md:-mx-8 lg:-mx-10">
    <!-- ========== 目錄抬頭 ========== -->
    <header class="relative overflow-hidden border-b border-beige-dark/40 px-4 pb-10 pt-6 sm:px-6 sm:pb-12 sm:pt-8 md:px-8 lg:px-10">
      <div
        class="pointer-events-none absolute inset-0 opacity-30"
        aria-hidden="true"
        style="background-image:
          linear-gradient(to right, color-mix(in srgb, #d4c4a8 50%, transparent) 1px, transparent 1px),
          linear-gradient(to bottom, color-mix(in srgb, #d4c4a8 50%, transparent) 1px, transparent 1px);
          background-size: 40px 40px;"
      ></div>

      <div class="relative z-10 grid gap-8 md:grid-cols-[1.2fr_0.8fr] md:items-end md:gap-12">
        <div class="grid gap-4 sm:gap-5">
          <p class="font-mono text-[10px] uppercase tracking-[0.28em] text-beige-dark sm:text-xs">
            Catalog · Index
          </p>
          <h1 class="font-display text-[clamp(2.75rem,12vw,7.5rem)] font-semibold leading-[0.88] tracking-[-0.04em] text-neutral-900">
            WORK
          </h1>
          <p class="max-w-md text-sm leading-relaxed text-neutral-600 sm:text-base">
            圖板目錄 — 以工程製圖的編排邏輯，呈列工業設計與純藝術實驗。
          </p>
        </div>

        <div class="flex flex-col items-start gap-2 md:items-end">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-beige-dark sm:text-xs">
            Plates
          </p>
          <p class="font-display text-5xl font-semibold tracking-tight text-purple-focus sm:text-6xl md:text-7xl">
            <span data-filter-count>{String(total).padStart(2, '0')}</span>
          </p>
        </div>
      </div>

      <!-- 篩選 -->
      <div
        class="relative z-10 mt-8 flex flex-wrap gap-2 sm:mt-10"
        role="group"
        aria-label="依分類篩選"
      >
        {
          categories.map((cat) => (
            <button
              type="button"
              data-filter={cat}
              aria-pressed={cat === 'all' ? 'true' : 'false'}
              class:list={[
                'filter-chip inline-flex min-h-10 items-center border px-3 font-mono text-[10px] uppercase tracking-[0.16em] transition-colors sm:min-h-11 sm:px-4 sm:text-xs',
                cat === 'all' && 'is-active',
              ]}
            >
              {cat === 'all' ? 'All' : cat}
            </button>
          ))
        }
      </div>
    </header>

    <!-- ========== 圖板列表 ========== -->
    <div class="px-4 py-10 sm:px-6 sm:py-12 md:px-8 md:py-16 lg:px-10">
      <ul class="grid gap-12 sm:gap-16 md:gap-20 lg:gap-24" role="list">
        {
          projects.map((project, i) => {
            const index = String(i + 1).padStart(2, '0');
            const odd = i % 2 === 1;

            return (
              <li
                data-catalog-plate
                data-category={project.data.category}
                class="catalog-plate"
              >
                <a
                  href={withBase(`portfolio/${project.id}`)}
                  class:list={[
                    'group grid items-stretch gap-5 sm:gap-6 md:gap-10 lg:gap-14',
                    'md:grid-cols-12',
                  ]}
                >
                  {/* 圖面 */}
                  <div
                    data-magnet
                    class:list={[
                      'relative overflow-hidden border border-beige-dark/50 bg-beige-dark/10 will-change-transform md:col-span-7',
                      odd && 'md:col-start-6',
                    ]}
                  >
                    <div class="aspect-[4/5] overflow-hidden sm:aspect-[5/6] lg:aspect-[4/5]">
                      <div data-catalog-img class="h-[115%] w-full will-change-transform">
                        <Image
                          src={project.data.heroImage}
                          alt={project.data.title}
                          class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                          widths={[480, 720, 960, 1280]}
                          sizes="(max-width: 768px) 100vw, 58vw"
                          loading={i < 2 ? 'eager' : 'lazy'}
                        />
                      </div>
                    </div>

                    {/* 工程角標 */}
                    <span
                      class="pointer-events-none absolute left-0 top-0 h-6 w-6 border-l-2 border-t-2 border-purple-focus/80 sm:h-8 sm:w-8"
                      aria-hidden="true"
                    />
                    <span
                      class="pointer-events-none absolute bottom-0 right-0 h-6 w-6 border-b-2 border-r-2 border-purple-focus/80 sm:h-8 sm:w-8"
                      aria-hidden="true"
                    />

                    <span
                      class="pointer-events-none absolute bottom-3 right-3 font-display text-4xl font-semibold leading-none text-beige-light/85 mix-blend-difference sm:bottom-4 sm:right-4 sm:text-5xl md:text-6xl"
                      aria-hidden="true"
                    >
                      {index}
                    </span>
                  </div>

                  {/* 規格文字 */}
                  <div
                    class:list={[
                      'flex flex-col justify-center gap-3 sm:gap-4 md:col-span-5',
                      odd ? 'md:col-start-1 md:row-start-1 md:text-right' : '',
                    ]}
                  >
                    <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-beige-dark sm:text-xs">
                      Plate {index}
                      <span class="mx-2 text-beige-dark/50" aria-hidden="true">
                        /
                      </span>
                      {project.data.year}
                    </p>

                    <h2 class="font-display text-2xl font-medium tracking-tight text-neutral-900 transition-colors group-hover:text-purple-focus sm:text-3xl md:text-4xl lg:text-[2.75rem]">
                      {project.data.title}
                    </h2>

                    <p class="text-sm text-neutral-600 sm:text-base">{project.data.subtitle}</p>

                    <dl
                      class:list={[
                        'mt-2 grid gap-2 border-t border-beige-dark/40 pt-4 font-mono text-[10px] uppercase tracking-[0.14em] text-beige-dark sm:text-xs',
                        odd && 'md:ml-auto md:text-right',
                      ]}
                    >
                      <div class:list={['flex gap-3', odd && 'md:flex-row-reverse']}>
                        <dt class="text-beige-dark/70">Category</dt>
                        <dd class="text-neutral-700">{project.data.category}</dd>
                      </div>
                      <div class:list={['flex gap-3', odd && 'md:flex-row-reverse']}>
                        <dt class="text-beige-dark/70">Tag</dt>
                        <dd class="text-neutral-700">{project.data.tag}</dd>
                      </div>
                    </dl>

                    <span
                      class:list={[
                        'mt-3 inline-flex min-h-11 w-fit items-center gap-2 text-xs tracking-[0.16em] text-purple-focus sm:text-sm',
                        odd && 'md:ml-auto',
                      ]}
                    >
                      Open plate
                      <span
                        class="transition-transform duration-300 group-hover:translate-x-1"
                        aria-hidden="true"
                      >
                        →
                      </span>
                    </span>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>

      {
        projects.length === 0 && (
          <p class="py-20 text-center font-mono text-xs tracking-[0.18em] text-beige-dark">
            No plates yet.
          </p>
        )
      }
    </div>

    <!-- 底欄指引 -->
    <aside class="border-t border-beige-dark/40 px-4 py-8 sm:px-6 md:px-8 lg:px-10">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-beige-dark sm:text-xs">
          End of catalog · {String(total).padStart(2, '0')} plates
        </p>
        <a
          href={withBase('')}
          class="font-mono text-[10px] uppercase tracking-[0.18em] text-purple-focus transition-colors hover:text-purple-hover sm:text-xs"
        >
          ← Back to identity
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  import { initPlateCatalog } from '../../scripts/plate-catalog';

  const root = document.querySelector<HTMLElement>('[data-plate-catalog]');
  const cleanup = root ? initPlateCatalog(root) : () => {};

  document.addEventListener('astro:before-swap', () => cleanup(), { once: true });
</script>

<style>
  .filter-chip {
    border-color: color-mix(in srgb, #d4c4a8 70%, transparent);
    color: #737373;
    background: transparent;
  }

  .filter-chip:hover {
    border-color: #8a6bbe;
    color: #8a6bbe;
  }

  .filter-chip.is-active {
    border-color: #8a6bbe;
    background: #8a6bbe;
    color: #f1ead7;
  }

  .catalog-plate.is-hidden {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-catalog-img],
    [data-magnet] {
      transform: none !important;
      will-change: auto;
    }
  }
</style>
