---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/site';

const email = 'binglebb@gmail.com';
---

<BaseLayout title="Contact — Bingle" description="旋轉旋鈕解鎖聯絡信箱">
  <section class="mx-auto grid max-w-lg gap-8 sm:gap-10 md:gap-12" data-contact-knob>
    <header class="grid gap-2 sm:gap-3">
      <p class="text-[10px] uppercase tracking-[0.25em] text-beige-dark sm:text-xs">Contact</p>
      <h1 class="text-xl font-medium text-neutral-900 sm:text-2xl md:text-3xl">實體旋鈕</h1>
      <p class="text-sm text-neutral-600 sm:text-base" data-knob-hint>
        順時針旋轉到底以解鎖信箱 · 支援滑鼠拖曳與觸控畫圓
      </p>
    </header>

    <div class="flex flex-col items-center gap-8 sm:gap-10">
      <!-- 進度環 -->
      <div
        data-knob-progress
        class="knob-progress relative"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-label="旋鈕解鎖進度"
      >
        <button
          type="button"
          data-knob
          class="knob touch-none select-none"
          aria-label="聯絡旋鈕，按住並旋轉以解鎖"
        >
          <span data-knob-dial class="knob-dial">
            <span class="knob-tick" aria-hidden="true"></span>
            <span class="knob-hub" aria-hidden="true"></span>
            <span class="knob-grip" aria-hidden="true"></span>
          </span>
        </button>
      </div>

      <div
        data-knob-reveal
        class="knob-reveal w-full border border-beige-dark/50 bg-beige-light px-4 py-5 text-center sm:px-6 sm:py-6"
        hidden
      >
        <p class="mb-2 text-[10px] uppercase tracking-[0.2em] text-beige-dark sm:text-xs">
          Unlocked
        </p>
        <a
          href={`mailto:${email}`}
          class="break-all text-base font-medium text-purple-focus transition-colors hover:text-purple-hover sm:text-lg md:text-xl"
        >
          {email}
        </a>
      </div>
    </div>

    <nav class="flex flex-wrap gap-x-4 gap-y-2 border-t border-beige-dark/40 pt-6 text-xs tracking-[0.12em] text-neutral-500 sm:text-sm">
      <a href={withBase('future-plans')} class="hover:text-purple-focus">Future Plans →</a>
      <a href={withBase('secret-base')} class="hover:text-purple-focus">Secret Base →</a>
    </nav>
  </section>
</BaseLayout>

<script>
  import { initContactKnob } from '../scripts/knob-contact';

  const root = document.querySelector<HTMLElement>('[data-contact-knob]');
  const cleanup = root ? initContactKnob(root) : () => {};
  document.addEventListener('astro:before-swap', () => cleanup(), { once: true });
</script>

<style>
  .knob-progress {
    --knob-pct: 0%;
    width: min(72vw, 280px);
    aspect-ratio: 1;
    border-radius: 9999px;
    background: conic-gradient(
      #8a6bbe var(--knob-pct),
      color-mix(in srgb, #d4c4a8 45%, transparent) 0
    );
    padding: 10px;
    display: grid;
    place-items: center;
  }

  .knob {
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    border: 1px solid #d4c4a8;
    background:
      radial-gradient(circle at 35% 30%, #f8f3e6 0%, #f1ead7 45%, #e4d7bc 100%);
    box-shadow:
      inset 0 2px 6px rgba(255, 255, 255, 0.55),
      inset 0 -4px 10px rgba(140, 120, 90, 0.18),
      0 10px 28px color-mix(in srgb, #8a6bbe 12%, transparent);
    cursor: grab;
    position: relative;
    padding: 0;
  }

  .knob.is-dragging {
    cursor: grabbing;
  }

  .knob.is-unlocked {
    border-color: #8a6bbe;
    box-shadow:
      inset 0 2px 6px rgba(255, 255, 255, 0.55),
      0 0 0 2px color-mix(in srgb, #b6b9ff 55%, transparent),
      0 12px 32px color-mix(in srgb, #8a6bbe 22%, transparent);
  }

  .knob-dial {
    position: absolute;
    inset: 12%;
    border-radius: 9999px;
    border: 1px dashed color-mix(in srgb, #d4c4a8 70%, transparent);
    display: block;
    transform-origin: center;
    will-change: transform;
  }

  .knob-tick {
    position: absolute;
    left: 50%;
    top: 8%;
    width: 3px;
    height: 22%;
    margin-left: -1.5px;
    border-radius: 2px;
    background: #8a6bbe;
    box-shadow: 0 0 8px color-mix(in srgb, #b6b9ff 60%, transparent);
  }

  .knob-hub {
    position: absolute;
    inset: 34%;
    border-radius: 9999px;
    border: 1px solid #d4c4a8;
    background: #f1ead7;
  }

  .knob-grip {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: repeating-conic-gradient(
      from 0deg,
      transparent 0deg 8deg,
      color-mix(in srgb, #d4c4a8 22%, transparent) 8deg 9deg
    );
    opacity: 0.55;
    pointer-events: none;
  }

  .knob-reveal {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .knob-reveal.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .knob-reveal {
      transition: none;
    }
  }
</style>
