---
import '../styles/global.css';
import TopNav from '../components/TopNav.astro';
import BottomNav from '../components/BottomNav.astro';
import { withBase } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  /** 全寬無邊距（無限畫布等） */
  fullBleed?: boolean;
  /** 隱藏頁尾（沉浸式頁面） */
  hideFooter?: boolean;
}

const {
  title = 'Bingle — Portfolio',
  description = '陳禹賓 Bingle 的作品集 — 工業設計與純藝術創作',
  fullBleed = false,
  hideFooter = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Noto+Sans+TC:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <TopNav currentPath={currentPath} />

    <main
      class:list={[
        'flex-1',
        fullBleed
          ? 'relative w-full overflow-hidden'
          : 'grid-container py-6 sm:py-8 md:py-10 lg:py-12',
      ]}
    >
      <slot />
    </main>

    {
      !hideFooter && (
        <footer class="border-t border-beige-dark/50 pb-[calc(4.25rem+env(safe-area-inset-bottom))] pt-6 md:pb-6 lg:pt-8">
          <div class="grid-container flex flex-col gap-3 text-[10px] uppercase tracking-[0.18em] text-beige-dark sm:text-xs md:flex-row md:items-center md:justify-between">
            <span>© {new Date().getFullYear()} Chen Yu-Bin</span>
            <div class="flex flex-wrap gap-x-4 gap-y-1">
              <a href={withBase('future-plans')} class="transition-colors hover:text-purple-focus">
                Plans
              </a>
              <a href={withBase('secret-base')} class="transition-colors hover:text-purple-focus">
                Secret
              </a>
              <span class="text-beige-dark/70">Industrial Design · Fine Art</span>
            </div>
          </div>
        </footer>
      )
    }

    <BottomNav currentPath={currentPath} />
  </body>
</html>

<style is:global>
  :focus-visible {
    outline: 2px solid #8a6bbe;
    outline-offset: 2px;
  }
</style>
