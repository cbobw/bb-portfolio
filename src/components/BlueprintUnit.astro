---
/**
 * 藍圖幾何單元：依 shape 繪製技術感構件
 * shape: hex | circle | tri | rect | diamond | iso | ring | cross
 */
interface Props {
  shape: 'hex' | 'circle' | 'tri' | 'rect' | 'diamond' | 'iso' | 'ring' | 'cross';
  code?: string;
}

const { shape, code = '' } = Astro.props;
---

<svg class="bp-geom" viewBox="0 0 200 160" aria-hidden="true">
  <!-- 基準十字與量測輔助線 -->
  <line class="bp-guide" x1="100" y1="12" x2="100" y2="148" />
  <line class="bp-guide" x1="20" y1="80" x2="180" y2="80" />
  <line class="bp-dim" x1="28" y1="150" x2="172" y2="150" />
  <line class="bp-dim" x1="28" y1="146" x2="28" y2="154" />
  <line class="bp-dim" x1="172" y1="146" x2="172" y2="154" />

  {
    shape === 'hex' && (
      <>
        <polygon
          class="bp-stroke bp-fill"
          points="100,28 148,54 148,106 100,132 52,106 52,54"
        />
        <circle class="bp-stroke" cx="100" cy="80" r="22" />
        <circle class="bp-accent" cx="100" cy="80" r="3" />
      </>
    )
  }

  {
    shape === 'circle' && (
      <>
        <circle class="bp-stroke bp-fill" cx="100" cy="80" r="48" />
        <circle class="bp-stroke" cx="100" cy="80" r="28" />
        <line class="bp-accent" x1="100" y1="28" x2="100" y2="48" />
        <line class="bp-accent" x1="100" y1="112" x2="100" y2="132" />
        <line class="bp-accent" x1="48" y1="80" x2="68" y2="80" />
        <line class="bp-accent" x1="132" y1="80" x2="152" y2="80" />
        <circle class="bp-accent" cx="100" cy="80" r="2.5" />
      </>
    )
  }

  {
    shape === 'tri' && (
      <>
        <polygon class="bp-stroke bp-fill" points="100,30 158,128 42,128" />
        <line class="bp-stroke" x1="100" y1="30" x2="100" y2="128" />
        <circle class="bp-accent" cx="100" cy="95" r="3" />
      </>
    )
  }

  {
    shape === 'rect' && (
      <>
        <rect class="bp-stroke bp-fill" x="48" y="36" width="104" height="88" />
        <rect class="bp-stroke" x="64" y="52" width="72" height="56" />
        <line class="bp-accent" x1="48" y1="80" x2="152" y2="80" />
        <line class="bp-accent" x1="100" y1="36" x2="100" y2="124" />
      </>
    )
  }

  {
    shape === 'diamond' && (
      <>
        <polygon class="bp-stroke bp-fill" points="100,28 156,80 100,132 44,80" />
        <polygon class="bp-stroke" points="100,48 132,80 100,112 68,80" />
        <circle class="bp-accent" cx="100" cy="80" r="3" />
      </>
    )
  }

  {
    shape === 'iso' && (
      <>
        <polygon class="bp-stroke bp-fill" points="100,34 148,58 148,106 100,130 52,106 52,58" />
        <polyline class="bp-stroke" points="52,58 100,82 148,58" />
        <line class="bp-stroke" x1="100" y1="82" x2="100" y2="130" />
        <line class="bp-accent" x1="76" y1="70" x2="124" y2="94" />
      </>
    )
  }

  {
    shape === 'ring' && (
      <>
        <circle class="bp-stroke bp-fill" cx="100" cy="80" r="50" />
        <circle class="bp-stroke bp-fill-cut" cx="100" cy="80" r="28" />
        <circle class="bp-stroke" cx="100" cy="80" r="14" />
        <line class="bp-dim" x1="100" y1="30" x2="100" y2="50" />
        <line class="bp-dim" x1="150" y1="80" x2="172" y2="80" />
      </>
    )
  }

  {
    shape === 'cross' && (
      <>
        <rect class="bp-stroke bp-fill" x="82" y="30" width="36" height="100" />
        <rect class="bp-stroke bp-fill" x="50" y="62" width="100" height="36" />
        <circle class="bp-stroke" cx="100" cy="80" r="10" />
        <circle class="bp-accent" cx="100" cy="80" r="2.5" />
      </>
    )
  }

  {
    code && (
      <text class="bp-code" x="100" y="18" text-anchor="middle">
        {code}
      </text>
    )
  }
</svg>

<style>
  .bp-geom {
    width: 100%;
    height: auto;
    display: block;
  }

  .bp-guide {
    fill: none;
    stroke: color-mix(in srgb, #d4c4a8 55%, transparent);
    stroke-width: 0.75;
    stroke-dasharray: 3 4;
    transition: stroke 0.25s ease;
  }

  :global([data-mode='wireframe']) .bp-guide {
    stroke: color-mix(in srgb, #8a6bbe 45%, transparent);
  }

  .bp-stroke {
    fill: none;
    stroke: var(--bp-stroke, #d4c4a8);
    stroke-width: 1.6;
    stroke-linejoin: miter;
    transition:
      stroke 0.25s ease,
      fill 0.25s ease;
  }

  .bp-fill {
    fill: var(--bp-fill, color-mix(in srgb, #b6b9ff 28%, #f1ead7));
  }

  .bp-fill-cut {
    fill: var(--bp-cut, #f1ead7);
  }

  .bp-accent {
    fill: none;
    stroke: #8a6bbe;
    stroke-width: 1.25;
  }

  .bp-accent[r] {
    fill: #8a6bbe;
    stroke: none;
  }

  .bp-dim {
    fill: none;
    stroke: #8a6bbe;
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }

  .bp-code {
    fill: #6e5f4b;
    font-size: 9px;
    letter-spacing: 0.18em;
    font-family: 'Space Mono', monospace;
    transition: fill 0.25s ease;
  }

  :global([data-mode='wireframe']) .bp-code {
    fill: #8a6bbe;
  }
</style>
