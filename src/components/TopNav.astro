---
import { stripBase, withBase } from '../utils/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: '/', label: 'Home', labelZh: '首頁' },
  { href: '/portfolio', label: 'Work', labelZh: '作品' },
  { href: '/contact', label: 'Contact', labelZh: '聯絡' },
  { href: '/about', label: 'About', labelZh: '關於' },
];

const playItems = [
  { href: '/future-plans', label: 'Plans' },
  { href: '/secret-base', label: 'Secret' },
];

const path = stripBase(currentPath);

function isActive(href: string): boolean {
  if (href === '/') return path === '/' || path === '';
  return path.startsWith(href);
}
---

<header class="border-b border-beige-dark/60 bg-beige-light/95 backdrop-blur-sm">
  <nav class="grid-container flex h-12 items-center justify-between sm:h-14 lg:h-16" aria-label="主要導覽">
    <a
      href={withBase('')}
      class="font-heading text-sm font-bold tracking-[0.08em] text-neutral-800 transition-colors hover:text-purple-focus sm:text-base"
    >
      Bingle
    </a>

    <div class="hidden items-center gap-6 md:flex lg:gap-10">
      <ul class="flex items-center gap-6 lg:gap-10">
        {
          navItems.map(({ href, label, labelZh }) => (
            <li>
              <a
                href={withBase(href.replace(/^\//, ''))}
                class:list={[
                  'nav-link relative py-1 text-xs lg:text-sm',
                  isActive(href) && 'nav-link-active',
                ]}
                aria-current={isActive(href) ? 'page' : undefined}
              >
                <span class="hidden lg:inline">{label}</span>
                <span class="lg:hidden">{labelZh}</span>
                {isActive(href) && (
                  <span class="absolute inset-x-0 -bottom-1 h-px bg-purple-focus" />
                )}
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="flex items-center gap-3 border-l border-beige-dark/50 pl-5 lg:gap-4 lg:pl-6">
        {
          playItems.map(({ href, label }) => (
            <li>
              <a
                href={withBase(href.replace(/^\//, ''))}
                class:list={[
                  'font-heading text-[10px] font-semibold tracking-[0.12em] text-warm-taupe transition-colors hover:text-purple-focus lg:text-xs',
                  isActive(href) && 'text-purple-focus',
                ]}
                aria-current={isActive(href) ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>
