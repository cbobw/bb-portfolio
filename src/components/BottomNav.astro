---
import { stripBase, withBase } from '../utils/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: '/', labelZh: '首頁', icon: 'home' },
  { href: '/portfolio', labelZh: '作品', icon: 'work' },
  { href: '/contact', labelZh: '聯絡', icon: 'contact' },
  { href: '/about', labelZh: '關於', icon: 'about' },
] as const;

const path = stripBase(currentPath);

function isActive(href: string): boolean {
  if (href === '/') return path === '/' || path === '';
  return path.startsWith(href);
}
---

<nav
  class="fixed inset-x-0 bottom-0 z-50 border-t border-beige-dark/70 bg-beige-light/95 backdrop-blur-sm md:hidden"
  aria-label="行動裝置導覽"
>
  <ul class="grid grid-cols-4">
    {
      navItems.map(({ href, labelZh, icon }) => (
        <li>
          <a
            href={withBase(href.replace(/^\//, ''))}
            class:list={[
              'flex min-h-11 flex-col items-center gap-1 px-1 py-2.5 font-sans text-[10px] tracking-wide transition-colors sm:py-3 sm:text-xs',
              isActive(href)
                ? 'text-purple-focus'
                : 'text-neutral-600 hover:text-purple-focus',
            ]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            <span class="block h-5 w-5" aria-hidden="true">
              {icon === 'home' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-full w-full">
                  <path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5Z" />
                </svg>
              )}
              {icon === 'work' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-full w-full">
                  <rect x="3" y="7" width="18" height="13" rx="1" />
                  <path d="M8 7V5.5A1.5 1.5 0 0 1 9.5 4h5A1.5 1.5 0 0 1 16 5.5V7" />
                </svg>
              )}
              {icon === 'contact' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-full w-full">
                  <circle cx="12" cy="12" r="8.25" />
                  <path d="M12 7.5v5l3 1.75" />
                </svg>
              )}
              {icon === 'about' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-full w-full">
                  <circle cx="12" cy="8" r="3.25" />
                  <path d="M5.5 19.5c1.4-3.2 3.7-4.75 6.5-4.75s5.1 1.55 6.5 4.75" />
                </svg>
              )}
            </span>
            <span>{labelZh}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<div class="h-[calc(4.25rem+env(safe-area-inset-bottom))] md:hidden" aria-hidden="true"></div>
